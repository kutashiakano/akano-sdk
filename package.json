{
  "name": "@kutashiakanocanzy/sdk",
  "version": "0.2.2-beta.9",
  "description": "Multi-platform bot helpers: WhatsApp core plus Telegram and Discord adapters",
  "keywords": [
    "sdk",
    "baileys"
  ],
  "license": "MIT",
  "author": "akano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutashiakano/akano-sdk.git"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./lib/voip": {
      "types": "./dist/cjs/lib/voip/index.d.ts",
      "import": "./dist/esm/lib/voip/index.js",
      "require": "./dist/cjs/lib/voip/index.js"
    },
    "./lib/*": {
      "types": "./dist/cjs/lib/*.d.ts",
      "import": "./dist/esm/lib/*.js",
      "require": "./dist/cjs/lib/*.js"
    },
    "./sdk/*": {
      "types": "./dist/cjs/sdk/*.d.ts",
      "import": "./dist/esm/sdk/*.js",
      "require": "./dist/cjs/sdk/*.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@cacheable/node-cache": "^1.7.2",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@whiskeysockets/baileys": "v7.0.0-rc14",
    "awesome-phonenumber": "2.59.0",
    "baileys_helper": "^1.0.6",
    "chokidar": "4.0.3",
    "dotenv": "^16.5.0",
    "file-type": "16.5.2",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.4",
    "https-proxy-agent": "^5.0.1",
    "libsodium-wrappers": "^0.8.4",
    "mime-types": "3.0.1",
    "miniget": "4.2.3",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.0",
    "mongodb": "6.21.0",
    "node-cron": "^4.2.1",
    "node-id3": "0.2.7",
    "node-webpmux": "^3.2.1",
    "pino": "^9.7.0",
    "qrcode-terminal": "^0.12.0",
    "rootpath": "^0.1.2",
    "sharp": "0.35.4",
    "syntax-error": "^1.4.0",
    "grammy": "^1.46.0",
    "@grammyjs/files": "^1.1.0",
    "@grammyjs/auto-retry": "^2.0.0",
    "discord.js": "^14.26.0",
    "opusscript": "0.0.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "better-sqlite3": "12.6.2",
    "ioredis": "5.6.0",
    "mysql2": "3.16.2",
    "pg": "8.17.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.cjs.json",
    "build": "npm run build:cjs && npm run build:esm && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "type": "commonjs"
}